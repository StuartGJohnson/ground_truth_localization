<?xml version="1.0"?>
<package format="3">
  <name>ground_truth_localization</name>
  <version>0.1.0</version>
  <description>Republish simulator ground-truth Odometry as operational odometry and TF.</description>
  <maintainer email="stuart.g.johnson@gmail.com">Stuart G Johnson</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
